# Single source of truth for the RoboCasa simulator layer.
#
# Read by all three consumers, so they cannot drift:
#   - the Makefile          (`include`s this file, passes --build-arg)
#   - base/Dockerfile       (declares the ARGs, no defaults -- see the guard there)
#   - sim/robocasa/robocasa.sh  (`source`s it to check out the same commits and
#                                stamp the asset dataset's version marker)
#
# Syntax must stay valid for BOTH make and sh: KEY=value, no spaces, no quotes.
#
# Bump deliberately. robosuite master and robocasa main both move, so a branch
# name is not a pin, and task02's stage functions are hand-written mirrors of
# RoboCasa source -- re-run tests/runtime/test_stage_credit.py after any bump.

# robosuite, 2026-07-11
ROBOSUITE_SHA=5ce6643f3092639d08f7b0f90ed1c6a84f50552c

# robocasa v1.0.1, 2026-07-07
ROBOCASA_SHA=b4684e6ee37d377cc392e98302a6b916d588b415

# The asset dataset version this code expects. verify_assets.py compares it to
# the ROBOCASA_ASSET_VERSION marker inside the mounted tree, so a stale mount
# fails loudly instead of silently changing the scenes.
ROBOCASA_ASSET_VERSION=v1.0.1

# The shared simulator image every RoboCasa task derives from.
ROBOCASA_SIM_IMAGE=rlebench-robocasa-sim:1.0.1
