# Single source of truth for the PERCEPTION layer -- the two models the task01 L2/L3
# harness serves. Read by all three consumers, so they cannot drift:
#   - the Makefile          (`include`s this file, passes --build-arg)
#   - Dockerfile            (declares the ARGs, no defaults -- see the guard there)
#   - sim/perception/perception.sh (`source`s it to check out the same commits)
#
# Syntax must stay valid for BOTH make and sh: KEY=value, no spaces, no quotes.
#
# The commits are the ones cap-x pins, because this is a port of cap-x's perception
# stack and a different commit is a different harness.

# SAM3, text-prompted segmentation. cap-x's fork.
SAM3_REPO=https://github.com/Max-Fu/sam3.git
SAM3_SHA=6fe87d64a5beb9084923d7a9e002741178635b09

# The SAM3 weights, resolved by sam3.model_builder through huggingface_hub.
# GATED: the repo requires an accepted access request, so `perception.sh fetch` needs
# HF_TOKEN from an account that has one. Nothing downstream touches the network -- the
# cache is baked into the image and HF_HUB_OFFLINE is set.
SAM3_HF_REPO=facebook/sam3

# Contact-GraspNet, grasp proposals. cap-x's fork of the PyTorch port. Its checkpoint
# (26 MB) ships INSIDE the repo at checkpoints/contact_graspnet, so there is no second
# download and nothing to pin separately.
CGN_REPO=https://github.com/uynitsuj/contact_graspnet_pytorch.git
CGN_SHA=da3dcfb2f53e43b186083ee4a9d1e232f73efc98

# Torch. Pinned because two models' numerics are part of what a run is scored against.
# The remaining Python dependencies are fixed in requirements.lock, which consumes
# this version through pip's environment-variable expansion.
TORCH_VERSION=2.8.0
